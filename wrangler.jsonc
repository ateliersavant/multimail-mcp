{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multimail-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: the MCP SDK; global_fetch_strictly_public: required by the OAuth provider for Client ID Metadata Documents.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Local/preview only. The production route and hostname come from the git-ignored deploy.local.json via scripts/deploy.mjs,
  // so no real hostname ever enters this repository.
  "workers_dev": true,
  // OAuth state (clients, grants, tokens, sign-in transactions) lives in one Durable Object with SQLite storage:
  // strongly consistent, unlike KV, whose cross-location lag refused a valid authorization code on 2026-11-03.
  "durable_objects": { "bindings": [{ "name": "OAUTH_STORE", "class_name": "OAuthStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OAuthStore"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Secrets are set with `wrangler secret put`, never written here. Listing them lets `wrangler types` know about them.
  "secrets": { "required": ["PUBLIC_URL", "TENANTS_JSON", "ALLOWED_PRINCIPALS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"] }
}
